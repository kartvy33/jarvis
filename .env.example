# JARVIS AI configuration
# Copy this file to .env if you want to keep your settings together.
# JARVIS currently reads environment variables directly, so on Windows
# you can also set them with "setx" as shown in README.md.

# auto = Ollama first, then OpenAI, then offline fallback
# ollama = local only
# openai = OpenAI API only
# offline = no AI network calls
JARVIS_AI=auto

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (optional; API usage may incur charges)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
