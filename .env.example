# JARVIS V1.5 settings
JARVIS_AI=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Android ADB
ADB_PATH=adb
# Optional: force JARVIS to one wireless ADB target when multiple ADB entries appear.
# Example: JARVIS_ADB_DEVICE=10.254.0.105:40445
JARVIS_ADB_DEVICE=

# ESP32 local network controller
ESP32_IP=
ESP32_PORT=80
ESP32_TOKEN=change-me
